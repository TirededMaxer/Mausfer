{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mausfer",
  "version": "0.1.0",
  "identifier": "com.mausfer.app",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mausfer",
        "width": 1080,
        "height": 760,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"]
  }
}
